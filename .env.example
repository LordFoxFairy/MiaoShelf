# 所有配置都有可运行的默认值；只在需要覆盖时复制为 .env。

# 公开店铺地址。
SHOP_URL=https://pay.ldxp.cn/shop/miaoli

# 本地商品 JSON 输出位置。
CATALOG_OUT=web/public/products.json

# Cloudflare Pages 项目名。
CF_PAGES_PROJECT=miaokit-catalog
CF_PORTAL_PROJECT=miaokit-portal

# 可选代理。支持 http://、https://、socks5:// 和 socks5h://。
# 示例：socks5h://user:pass@host:port
SOURCE_HTTP_PROXY=

# 手动同步默认不等待；launchd 会根据定时间隔自动注入抖动值。
SYNC_JITTER_MAX_MS=0

# 站点检查目标。默认不填时检查线上商品站。
AUDIT_URL=https://shop.miaokit.cloud/
