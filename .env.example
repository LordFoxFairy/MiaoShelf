# 复制为 .env 后按需修改。
# 密钥用 openssl rand -base64 32 生成，绝不要提交到 Git。

NODE_ENV=production
TZ=Asia/Shanghai

# ---- 站点 ----
PUBLIC_SITE_URL=https://catalog.example.com
NEXT_PUBLIC_SITE_NAME=MiaoKit Catalog

# ---- 数据库（SQLite，一个文件）----
DATABASE_URL="file:./prod.db"

# ---- 密钥（必填，至少 32 位）----
AUTH_SECRET=replace_with_openssl_rand_base64_32
CREDENTIAL_MASTER_KEY=replace_with_openssl_rand_base64_32

# ---- 货源平台 ----
LDXP_BASE_URL=https://www.ldxp.cn
# 允许跳转的域名，防开放重定向
LDXP_ALLOWED_REDIRECT_HOSTS=ldxp.cn,www.ldxp.cn,pay.ldxp.cn
# 写操作总开关，默认关闭
ENABLE_LDXP_WRITE=false
LDXP_WRITE_BATCH_LIMIT=10

# ---- 同步频率（秒）----
SYNC_SCHEDULER_INTERVAL_SECONDS=60
SYNC_HOT_SECONDS=60
SYNC_NORMAL_SECONDS=300
SYNC_COLD_SECONDS=1800
SYNC_FULL_CATALOG_SECONDS=3600

# ---- 数据新鲜度（秒）----
STATUS_FRESH_SECONDS=120
STATUS_STALE_SECONDS=900
CLICK_FRESH_SECONDS=30
CLICK_RESOLVE_TIMEOUT_MS=2000
REFRESH_LOCK_SECONDS=30

# ---- 并发与阈值 ----
SOURCE_ACCOUNT_CONCURRENCY=1
GLOBAL_SOURCE_CONCURRENCY=3
LOW_STOCK_THRESHOLD=5

# ---- 模拟登录 ----
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_PROFILE_ROOT=./data/browser-profiles

# ---- 日志与代理 ----
LOG_LEVEL=info
# 前面挂 Cloudflare 时必须设为 cloudflare，否则限流会误伤所有用户
TRUSTED_PROXY_MODE=none
