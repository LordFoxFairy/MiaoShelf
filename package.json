{
  "name": "miaokit-catalog",
  "version": "0.1.0",
  "private": true,
  "description": "商品聚合、同步与展示管理平台",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local --tsconfig tsconfig.worker.json src/worker/index.ts",
    "worker:dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local --tsconfig tsconfig.worker.json src/worker/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "create-admin": "tsx scripts/create-admin.ts",
    "check-source": "tsx --env-file-if-exists=.env --tsconfig tsconfig.worker.json scripts/check-source.ts",
    "smoke-shop": "tsx --env-file-if-exists=.env --tsconfig tsconfig.worker.json scripts/smoke-shop.ts",
    "shop-cookie": "tsx --env-file-if-exists=.env --tsconfig tsconfig.worker.json scripts/shop-cookie.ts",
    "sync": "tsx --env-file-if-exists=.env --tsconfig tsconfig.worker.json scripts/sync-catalog.ts",
    "schedule": "bash scripts/schedule.sh",
    "check-site": "tsx --tsconfig tsconfig.worker.json scripts/audit-site.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "decimal.js": "^10.4.3",
    "jose": "^6.2.8",
    "lucide-react": "^0.427.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "pino": "^9.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.2",
    "socks-proxy-agent": "^10.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.2",
    "tw-animate-css": "^1.4.0",
    "undici": "^8.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "playwright": "^1.62.1",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.16.2",
    "typescript": "^5",
    "vitest": "^2.0.3"
  },
  "packageManager": "pnpm@8.14.0"
}
