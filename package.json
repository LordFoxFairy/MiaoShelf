{
  "name": "miaokit-catalog",
  "version": "0.1.0",
  "private": true,
  "description": "商品聚合、同步与展示管理平台",
  "scripts": {
    "typecheck": "tsc --noEmit --project tsconfig.worker.json",
    "test": "tsx --test tests/*.test.ts",
    "build:web": "pnpm --dir web build",
    "build:portal": "pnpm --dir portal build",
    "build": "pnpm build:web && pnpm build:portal",
    "sync": "tsx --env-file-if-exists=.env --tsconfig tsconfig.worker.json scripts/sync-catalog.ts",
    "schedule": "bash scripts/schedule.sh",
    "check-site": "tsx --tsconfig tsconfig.worker.json scripts/audit-site.ts"
  },
  "dependencies": {
    "decimal.js": "^10.4.3",
    "socks-proxy-agent": "^10.1.0",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "playwright": "^1.62.1",
    "tsx": "^4.16.2",
    "typescript": "^5"
  },
  "packageManager": "pnpm@8.14.0"
}
