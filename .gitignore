node_modules/
.pnp
.pnp.js

# build outputs
dist/
build/
*.tsbuildinfo

# env & secrets — never commit
.env
.env.*
!.env.example

# runtime state and browser test output
/data/
playwright-report/
test-results/
.playwright/

# 本地私密笔记 —— 服务器地址、凭据等，绝不能提交
*.local.md
SERVER.local.md
.secrets/

# 保留对历史本地数据库的保护，避免旧数据被误提交
*.db
*.db-journal
*.db-wal
*.db-shm

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# editors / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/*
!.idea/.gitignore

# 采集产物：商品图和数据由 pnpm sync 生成，不进版本库
web/public/img/
web/public/products.json
web/dist/

# 环境变量没传进脚本时会误建的目录（曾装过临时凭据）
undefined/

# 门户构建产物
portal/dist/
